# Google Gemini API Key — Get yours for free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Server Configuration
PORT=3002

# The exact ID of your Chrome Extension (found in chrome://extensions)
CORS_ORIGIN=chrome-extension://your-extension-id-here

# Auth Password to prevent spam on your public endpoint (match this in extension/config.js)
EXTENSION_SECRET_KEY=your-custom-secret-here

# Rate Limiting (requests per 15 minutes per IP)
RATE_LIMIT_MAX=50
